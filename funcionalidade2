<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Relatório de Ocupação de Curso</title>

<style>

/* RESET */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Segoe UI", Arial, sans-serif;
}

body {
  background-color: #f4f4f4;
}

/* ==========================
   TOPO AZUL
========================== */
.top-bar {
  background-color: #0056A6;
  padding: 35px 40px;
  color: white;
}

.top-bar h1 {
  font-size: 22px;
  font-weight: 600;
}

.sub {
  font-size: 14px;
  opacity: 0.9;
}

.btn-gerenciar {
  float: right;
  background-color: #FFC928;
  color: #333;
  padding: 10px 18px;
  border-radius: 6px;
  font-weight: 600;
  text-decoration: none;
  margin-top: -35px;
}

.top-small {
  margin-top: 25px;
  font-size: 15px;
  cursor: pointer;
}

.page-title {
  margin-top: 10px;
  font-size: 26px;
  font-weight: bold;
}

.page-sub {
  margin-top: 5px;
  font-size: 15px;
  opacity: 0.9;
}

/* ==========================
   CONTAINER
========================== */
.container {
  max-width: 900px;
  margin: 30px auto;
}

/* ==========================
   CARD PRINCIPAL
========================== */
.card {
  background: white;
  padding: 0;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  overflow: hidden;
}

.card-title {
  background-color: #0056A6;
  color: white;
  padding: 14px 20px;
  font-size: 18px;
  font-weight: 600;
}

.filter-area {
  padding: 20px;
}

.filter-area label {
  font-size: 15px;
  font-weight: bold;
}

select {
  width: 100%;
  margin-top: 6px;
  padding: 10px;
  border-radius: 6px;
  border: 1px solid #ccc;
  font-size: 15px;
}

/* Botão amarelo */
.btn-yellow {
  background-color: #FFC928;
  color: #333;
  border: none;
  padding: 10px 25px;
  font-size: 15px;
  font-weight: bold;
  border-radius: 6px;
  cursor: pointer;
  margin-top: 18px;
}

.btn-yellow:hover {
  background-color: #e6b31f;
}

.result {
  padding: 20px;
}

.result-title {
  font-size: 15px;
  font-weight: bold;
  margin-bottom: 10px;
}

/* ==========================
   TABELA
========================== */

table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 10px;
}

table thead {
  background-color: #f1f1f1;
}

table th {
  padding: 10px;
  font-size: 14px;
  text-align: left;
  color: #333;
}

table td {
  padding: 10px;
  font-size: 14px;
  color: #333;
  border-top: 1px solid #eee;
}

table tr:hover {
  background-color: #fafafa;
}

</style>

</head>
<body>

  <!-- TOPO AZUL -->
  <div class="top-bar">
    <h1>Sistema de Alocação de Salas</h1>
    <span class="sub">Gestão completa de professores, disciplinas e horários</span>

    <a href="#" class="btn-gerenciar">Gerenciar Cadastros</a>

    <div class="top-small">← Voltar</div>

    <h2 class="page-title">Relatório de Ocupação de Curso</h2>
    <p class="page-sub">Pesquise as alocações de disciplina por curso</p>
  </div>

  <div class="container">

    <div class="card">

      <div class="card-title">Filtros de Pesquisa</div>

      <div class="filter-area">
        <label for="curso">Curso</label>
        <select id="curso">
          <option value="">Selecione um curso</option>
          <option value="ads">Análise e Desenvolvimento de Sistemas</option>
          <option value="si">Sistemas de Informação</option>
          <option value="eng">Engenharia de Software</option>
        </select>

        <button class="btn-yellow">Pesquisar</button>
      </div>

      <div class="result">
        <p class="result-title">Resultados Encontrados (1)</p>

        <table>
          <thead>
            <tr>
              <th>DISCIPLINA</th>
              <th>PROFESSOR</th>
              <th>SALA</th>
              <th>DIA</th>
              <th>HORÁRIO</th>
              <th>PERÍODO</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Banco de Dados II</td>
              <td>Mateus Souza</td>
              <td>202 (B)</td>
              <td>Segunda</td>
              <td>19:00 - 22:30</td>
              <td>2025/1</td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>

  </div>

</body>
</html>
